# --- LLM API (OpenAI-compatible) ---
# Used by all graph/*/*.py scripts that call an LLM, and by the synthesis
# pipeline for instruction/PRM/pytest generation.
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Some graph scripts also honor these legacy names:
API_KEY=${LLM_API_KEY}
BASE_URL=${LLM_BASE_URL}
MODEL=${LLM_MODEL}

# --- Embedding API (OpenAI-compatible; optional falls back to LLM_*) ---
EMBEDDING_API_KEY=${LLM_API_KEY}
EMBEDDING_BASE_URL=${LLM_BASE_URL}
EMBEDDING_MODEL=text-embedding-3-large

# --- Claude Code CLI (used by the synthesis pipeline) ---
# The Claude CLI reads these directly.
ANTHROPIC_AUTH_TOKEN=sk-ant-...
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- GitHub (optional; only needed if you hit rate limits during download) ---
GITHUB_TOKEN=
